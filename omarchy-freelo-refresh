#!/usr/bin/env bash
# Aggregates Freelo dashboard data for the Omarchy Freelo widget.
# Auth is delegated to freelo-cli's own credential store.

set -uo pipefail   # -u: catch unset vars. pipefail: no -e, we handle exit codes ourselves and always emit JSON.

# Deadlines/limits for every credentialed `freelo` call.
readonly PER_CALL_TIMEOUT_SEC=15
readonly PER_CALL_KILL_AFTER_SEC=5
readonly MAX_RESPONSE_BYTES=$((2 * 1024 * 1024))   # per-response cap, enforced while streaming in
readonly WHOLE_JOB_TIMEOUT_SEC=45
readonly WHOLE_JOB_KILL_AFTER_SEC=5

# Re-exec once under `timeout` for a hard whole-job deadline (backstop beyond
# the per-call ones below). Guarded so it doesn't recurse.
if [[ -z ${FREELO_REFRESH_REEXEC:-} ]] && command -v timeout >/dev/null 2>&1; then
  export FREELO_REFRESH_REEXEC=1
  exec timeout --kill-after="${WHOLE_JOB_KILL_AFTER_SEC}s" "${WHOLE_JOB_TIMEOUT_SEC}s" "$0" "$@"
fi

project_id=""   # --project ID; empty means "projects only, no tasklists/tasks"

usage() {
  cat <<'EOF'
Usage: omarchy-freelo-refresh [--project ID]
  --project ID   Also fetch tasklists and tasks for this project ID
EOF
}

while (($#)); do
  case "$1" in
    --project)
      [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }
      project_id=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -n $project_id && ! $project_id =~ ^[0-9]+$ ]]; then
  echo "invalid --project" >&2
  exit 2
fi

# Bail out with valid-but-empty JSON if required tools are missing, so the widget doesn't crash.
command -v jq >/dev/null 2>&1 || {
  printf '%s\n' '{"schemaVersion":1,"state":"error","message":"jq is required.","projects":[],"tasklists":[],"tasks":[],"tracking":null}'
  exit 0
}

emit_state() {
  jq -n --arg state "$1" --arg message "$2" \
    '{schemaVersion:1,state:$state,message:$message,projects:[],tasklists:[],tasks:[],tracking:null}'
}

command -v freelo >/dev/null 2>&1 || {
  emit_state cli-not-installed "freelo-cli is not installed. See github.com/freeloio/freelo-cli."
  exit 0
}

if ! tmp=$(mktemp -d); then
  emit_state error "Could not prepare temporary storage for the Freelo refresh."
  exit 1
fi
trap 'rm -rf "$tmp"' EXIT

# Runs a command ($3..) under the per-call deadline/byte cap above.
# setsid puts it (pid==pgid) in its own process group so, after it returns,
# the whole group -- including any children it spawned -- can be reaped by
# signaling -$pid, not just the immediate child `timeout` itself would reach.
run_capped() {
  local out=$1 err=$2
  shift 2
  local fifo="$out.fifo"
  rm -f "$fifo"
  mkfifo "$fifo"

  setsid timeout --kill-after="${PER_CALL_KILL_AFTER_SEC}s" "${PER_CALL_TIMEOUT_SEC}s" \
    "$@" >"$fifo" 2>"$err" &
  local pid=$!

  head -c "$MAX_RESPONSE_BYTES" <"$fifo" >"$out"
  rm -f "$fifo"

  wait "$pid"
  local rc=$?

  # Guard against a reaped pid being recycled by the OS before this fires --
  # only signal the group if it's still alive under that pid.
  if kill -0 -- "-$pid" 2>/dev/null; then
    kill -TERM -- "-$pid" 2>/dev/null
    kill -KILL -- "-$pid" 2>/dev/null
  fi

  return "$rc"
}

warnings="$tmp/warnings"
: >"$warnings"

auth_err="$tmp/auth.err"
if run_capped "$tmp/auth.raw" "$auth_err" freelo auth status --agent \
    && [[ $(wc -c <"$tmp/auth.raw") -lt $MAX_RESPONSE_BYTES ]]; then
  auth=$(<"$tmp/auth.raw")
else
  auth=""
fi
if [[ "$(jq -r '.authenticated // false' <<<"$auth" 2>/dev/null)" != "true" ]]; then
  emit_state logged-out "Run 'freelo auth login' to connect Freelo."
  exit 0
fi

# `--agent` raw JSON isn't guaranteed to be a bare array/object vs. wrapped
# in an envelope key, so unwrap defensively rather than assume one shape.
unwrap_list() {
  jq 'if type == "array" then . else (.data // .items // .projects // .tasklists // .tasks // []) end' "$1" 2>/dev/null
}

unwrap_object() {
  jq 'if type == "object" then (.data // .) else null end' "$1" 2>/dev/null
}

# Runs `freelo <args...> --agent` via run_capped into $output.
# On failure (including a response that hit the byte cap), logs a one-line
# reason to $warnings and returns 1.
fetch() {
  local label=$1 output=$2
  shift 2
  local err="$tmp/$label.err"
  run_capped "$output" "$err" freelo "$@" --agent
  local rc=$?
  if [[ $rc -eq 0 && $(wc -c <"$output") -lt $MAX_RESPONSE_BYTES ]]; then
    return 0
  fi
  local reason
  if [[ $(wc -c <"$output") -ge $MAX_RESPONSE_BYTES ]]; then
    reason="response exceeded ${MAX_RESPONSE_BYTES}-byte limit, discarded"
    : >"$output"
  else
    reason=$(tr '\n' ' ' <"$err" | cut -c1-200)
    [[ -n $reason ]] || reason="timed out or failed (exit $rc)"
  fi
  printf '%s: %s\n' "$label" "$reason" >>"$warnings"
  return 1
}

# ---- Fetch data (independent calls run in parallel) ----

(
  fetch projects "$tmp/projects.raw" projects list \
    && unwrap_list "$tmp/projects.raw" >"$tmp/projects.json" \
    || printf '[]\n' >"$tmp/projects.json"
) &

(
  fetch tracking "$tmp/tracking.raw" tracking status \
    && unwrap_object "$tmp/tracking.raw" >"$tmp/tracking.json" \
    || printf 'null\n' >"$tmp/tracking.json"
) &

printf '[]\n' >"$tmp/tasklists.json"
printf '[]\n' >"$tmp/tasks.json"
if [[ -n $project_id ]]; then
  (
    fetch tasklists "$tmp/tasklists.raw" tasklists list --project "$project_id" \
      && unwrap_list "$tmp/tasklists.raw" >"$tmp/tasklists.json" \
      || printf '[]\n' >"$tmp/tasklists.json"
  ) &

  # No CLI subcommand exposes this endpoint's richer per-task fields
  # (priority_enum, due_date, tasklist{id,name}), so use the raw `api get`
  # passthrough instead. project_id is validated ^[0-9]+$ above.
  (
    fetch tasks "$tmp/tasks.raw" api get "/all-tasks?projects_ids[]=$project_id&state_id=1" \
      && jq '(.data.tasks // []) | map({
          id, name, worker, priority_enum, due_date, date_add,
          tasklist_id: .tasklist.id,
          tasklist_name: .tasklist.name
        })' "$tmp/tasks.raw" >"$tmp/tasks.json" \
      || printf '[]\n' >"$tmp/tasks.json"
  ) &
fi
wait

# ---- Assemble final JSON ----

warnings_json=$(sort -u "$warnings" | jq -Rsc 'split("\n") | map(select(length > 0))')

state=ready
message=""
if [[ $(jq 'length' <<<"$warnings_json") -gt 0 && $(jq 'length' "$tmp/projects.json") -eq 0 ]]; then
  state=error
  message="Freelo data could not be loaded."
fi

jq -n --arg state "$state" --arg message "$message" \
  --slurpfile projects "$tmp/projects.json" \
  --slurpfile tasklists "$tmp/tasklists.json" \
  --slurpfile tasks "$tmp/tasks.json" \
  --slurpfile tracking "$tmp/tracking.json" \
  --argjson warnings "$warnings_json" \
  '{schemaVersion:1,state:$state,message:$message,projects:$projects[0],tasklists:$tasklists[0],tasks:$tasks[0],tracking:$tracking[0],warnings:$warnings}'
